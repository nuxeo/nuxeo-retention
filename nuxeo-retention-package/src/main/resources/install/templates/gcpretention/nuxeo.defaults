## DO NOT EDIT THIS FILE, USE nuxeo.conf  ##
nuxeo.template.includes=gcpbinaries
gcpretention.target=.

# mandatory
nuxeo.gcp.retention.storage.bucket=
nuxeo.retention.core.binarymanager=org.nuxeo.ecm.core.storage.gcp.GoogleStorageBlobProvider

# fallback on default values
nuxeo.gcp.retention.project=${nuxeo.gcp.project}
nuxeo.gcp.retention.credentials=${nuxeo.gcp.credentials}

# optional
nuxeo.gcp.retention.storage.bucket_prefix=
