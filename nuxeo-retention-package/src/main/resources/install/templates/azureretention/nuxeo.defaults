## DO NOT EDIT THIS FILE, USE nuxeo.conf  ##
nuxeo.template.includes=azurebinaries
azureretention.target=.

# mandatory
nuxeo.storage.azure.retention.container=
nuxeo.storage.azure.retention.prefix=
nuxeo.retention.core.binarymanager=org.nuxeo.ecm.blob.azure.AzureBlobProvider

# fallback on default values
nuxeo.storage.azure.retention.account.name=${nuxeo.storage.azure.account.name}
nuxeo.storage.azure.retention.account.key=${nuxeo.storage.azure.account.key}

# optional
nuxeo.storage.azure.retention.cachesize=
nuxeo.storage.azure.retention.endpointProtocol=https
nuxeo.storage.azure.retention.cdn.host=
